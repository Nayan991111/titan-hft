/target
*.bin
.DS_Store
/data/
/results/raw/
__pycache__/
*.pyc

# Output of scripts/reproduce_paper_artifacts.sh: run output, not source.
artifacts/

# LaTeX build artifacts. main.bbl is deliberately NOT ignored: arXiv runs
# neither bibtex nor biber on an uploaded .bib, so the tarball must carry a
# prebuilt .bbl and it has to be in the repository to be bundled.
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.blg
docs/paper/*.pdf

# Delivery scripts and patches handed over for a session run. Working files,
# never part of the work: a patch of the repository committed into the
# repository also embeds whatever vocabulary the diff contains, which is how
# the authorship gate caught its first real footprint.
t[0-9]*.sh
t[0-9]*.patch
